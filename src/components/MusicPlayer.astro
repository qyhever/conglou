---
import musicCover from "@/assets/images/music.jpg";

const playlistUrl = "https://qyhever.com/mp3/playlist.json";
---

<aside
  data-music-player
  data-playlist-url={playlistUrl}
  class="music-player text-foreground"
  aria-label="音乐播放器"
>
  <audio data-music-audio preload="metadata"></audio>

  <div class="music-shell">
    <div class="music-cover" aria-hidden="true">
      <img src={musicCover.src} alt="" loading="lazy" decoding="async" />
      <span class="music-cover-ring"></span>
    </div>

    <div class="music-body">
      <div class="music-copy">
        <p data-music-title class="music-title" aria-live="polite">
          <span data-music-title-text class="music-title-text">加载歌单中</span>
        </p>
        <div class="music-meta">
          <p data-music-status class="music-status">点击播放后开始</p>
        </div>
      </div>

      <div class="music-controls">
        <button
          type="button"
          data-music-prev
          class="music-control"
          aria-label="上一首"
          disabled
        >
          <span aria-hidden="true" class="music-icon music-icon-prev"></span>
        </button>

        <button
          type="button"
          data-music-toggle
          class="music-toggle"
          aria-label="播放"
          disabled
        >
          <span
            data-music-play-icon
            aria-hidden="true"
            class="music-icon music-icon-play"></span>
          <span
            data-music-pause-icon
            aria-hidden="true"
            class="music-icon music-icon-pause hidden"></span>
        </button>

        <button
          type="button"
          data-music-next
          class="music-control"
          aria-label="下一首"
          disabled
        >
          <span aria-hidden="true" class="music-icon music-icon-next"></span>
        </button>
      </div>
    </div>

    <div class="music-progress-track" aria-hidden="true">
      <div data-music-progress class="music-progress"></div>
    </div>

    <p data-music-time class="music-time">0:00 / 0:00</p>
  </div>
</aside>

<style>
  .music-player {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 50;
    width: 280px;
    max-width: calc(100vw - 2rem);
    font-size: 12px;
  }

  .music-shell {
    position: relative;
    display: grid;
    grid-template-columns: 66px minmax(0, 1fr);
    gap: 10px;
    min-height: 86px;
    overflow: hidden;
    padding: 10px 12px 12px 10px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--background) 96%, white 4%),
      color-mix(in srgb, var(--background) 88%, var(--muted) 12%)
    );
    border: 1px solid color-mix(in srgb, var(--border) 76%, transparent);
    border-radius: 4px;
    box-shadow:
      0 16px 36px color-mix(in srgb, var(--foreground) 15%, transparent),
      0 1px 0 color-mix(in srgb, white 72%, transparent) inset;
    backdrop-filter: blur(14px);
  }

  [data-theme="dark"] .music-shell {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--background) 88%, #111 12%),
      color-mix(in srgb, var(--background) 78%, var(--muted) 22%)
    );
    box-shadow:
      0 16px 38px rgb(0 0 0 / 34%),
      0 1px 0 color-mix(in srgb, white 10%, transparent) inset;
  }

  .music-cover {
    position: relative;
    width: 66px;
    height: 66px;
    overflow: hidden;
    background: var(--muted);
    border: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
    border-radius: 3px;
    box-shadow: 0 6px 16px
      color-mix(in srgb, var(--foreground) 14%, transparent);
  }

  .music-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: saturate(0.75) contrast(1.05);
    transform: scale(2.35);
    transform-origin: 50% 50%;
  }

  .music-cover-ring {
    display: none;
    position: absolute;
    right: 7px;
    bottom: 7px;
    width: 18px;
    height: 18px;
    border: 2px solid rgb(255 255 255 / 72%);
    border-radius: 999px;
    box-shadow: 0 0 0 999px rgb(0 0 0 / 3%) inset;
  }

  .music-player[data-state="playing"] .music-cover img {
    animation: music-cover-pulse 1.6s ease-in-out infinite;
  }

  .music-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 1px;
  }

  .music-copy {
    min-width: 0;
  }

  .music-title,
  .music-status {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-title {
    --music-title-scroll-distance: 0px;
    --music-title-scroll-duration: 8s;

    position: relative;
    margin: 0;
    color: var(--foreground);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.35;
  }

  .music-title-text {
    display: inline-block;
    white-space: nowrap;
    will-change: transform;
  }

  .music-title.is-overflowing .music-title-text {
    padding-right: 18px;
    animation: music-title-marquee var(--music-title-scroll-duration) linear
      infinite;
  }

  .music-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    margin-top: 3px;
  }

  .music-status,
  .music-time {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 11px;
    line-height: 1.3;
  }

  .music-status {
    flex: 1 1 auto;
  }

  .music-time {
    position: absolute;
    right: 12px;
    bottom: 8px;
    font-variant-numeric: tabular-nums;
  }

  .music-controls {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
  }

  .music-control,
  .music-toggle {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: color-mix(in srgb, var(--foreground) 82%, transparent);
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .music-control {
    width: 26px;
    height: 26px;
    background: transparent;
  }

  .music-toggle {
    width: 30px;
    height: 30px;
    color: var(--accent-foreground);
    background: var(--accent);
    box-shadow: 0 6px 14px color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .music-control:hover,
  .music-toggle:hover {
    transform: translateY(-1px);
  }

  .music-control:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .music-toggle:hover {
    filter: brightness(1.05);
  }

  .music-control:disabled,
  .music-toggle:disabled {
    pointer-events: none;
    opacity: 0.38;
  }

  .music-progress-track {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: color-mix(in srgb, var(--muted) 72%, transparent);
  }

  .music-progress {
    width: 0;
    height: 100%;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 76%, white 24%),
      var(--accent)
    );
    transform-origin: left center;
    transition: width 220ms ease;
  }

  .music-icon {
    position: relative;
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .music-icon.hidden {
    display: none;
  }

  .music-icon-play {
    width: 0;
    height: 0;
    margin-left: 0.12rem;
    border-top: 0.34rem solid transparent;
    border-bottom: 0.34rem solid transparent;
    border-left: 0.52rem solid currentColor;
  }

  .music-icon-pause::before,
  .music-icon-pause::after {
    position: absolute;
    top: 0.18rem;
    width: 0.22rem;
    height: 0.68rem;
    content: "";
    background: currentColor;
    border-radius: 999px;
  }

  .music-icon-pause::before {
    left: 0.28rem;
  }

  .music-icon-pause::after {
    right: 0.28rem;
  }

  .music-icon-prev::before,
  .music-icon-next::before {
    position: absolute;
    top: 0.2rem;
    width: 0.12rem;
    height: 0.6rem;
    content: "";
    background: currentColor;
    border-radius: 999px;
  }

  .music-icon-prev::before {
    left: 0.18rem;
  }

  .music-icon-next::before {
    right: 0.18rem;
  }

  .music-icon-prev::after,
  .music-icon-next::after {
    position: absolute;
    top: 0.2rem;
    width: 0;
    height: 0;
    content: "";
    border-top: 0.3rem solid transparent;
    border-bottom: 0.3rem solid transparent;
  }

  .music-icon-prev::after {
    left: 0.34rem;
    border-right: 0.48rem solid currentColor;
  }

  .music-icon-next::after {
    right: 0.34rem;
    border-left: 0.48rem solid currentColor;
  }

  @keyframes music-cover-pulse {
    0%,
    100% {
      transform: scale(2.35);
    }
    50% {
      transform: scale(2.45);
    }
  }

  @keyframes music-title-marquee {
    0%,
    14% {
      transform: translateX(0);
    }

    86%,
    100% {
      transform: translateX(calc(var(--music-title-scroll-distance) * -1));
    }
  }

  @media (max-width: 640px) {
    .music-player {
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: auto;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-player[data-state="playing"] .music-cover img {
      animation: none;
    }

    .music-title.is-overflowing .music-title-text {
      animation: none;
      transform: none;
    }

    .music-progress {
      transition: none;
    }
  }
</style>

<script>
  type RawTrack = {
    title?: string;
    artist?: string;
    url?: string;
    baseUrl?: string;
    ext?: string;
  };

  type Track = {
    title: string;
    artist: string;
    src: string;
  };

  const player = document.querySelector<HTMLElement>("[data-music-player]");

  if (player && !player.dataset.initialized) {
    const root = player;

    root.dataset.initialized = "true";

    const playlistUrl =
      root.dataset.playlistUrl ?? "https://qyhever.com/mp3/playlist.json";
    const audio = root.querySelector<HTMLAudioElement>("[data-music-audio]");
    const title = root.querySelector<HTMLElement>("[data-music-title]");
    const titleText = root.querySelector<HTMLElement>(
      "[data-music-title-text]"
    );
    const status = root.querySelector<HTMLElement>("[data-music-status]");
    const time = root.querySelector<HTMLElement>("[data-music-time]");
    const progress = root.querySelector<HTMLElement>("[data-music-progress]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-music-toggle]");
    const prev = root.querySelector<HTMLButtonElement>("[data-music-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-music-next]");
    const playIcon = root.querySelector<HTMLElement>("[data-music-play-icon]");
    const pauseIcon = root.querySelector<HTMLElement>(
      "[data-music-pause-icon]"
    );

    const state = {
      tracks: [] as Track[],
      index: 0,
      isPlaying: false,
      isLoading: true,
      message: "",
    };

    function setText(element: HTMLElement | null, value: string) {
      if (element) element.textContent = value;
    }

    function refreshTitleScroll() {
      if (!title || !titleText) return;

      title.classList.remove("is-overflowing");
      title.style.removeProperty("--music-title-scroll-distance");
      title.style.removeProperty("--music-title-scroll-duration");

      requestAnimationFrame(() => {
        const overflow = titleText.scrollWidth - title.clientWidth;

        if (overflow <= 1) return;

        const distance = overflow + 18;
        const duration = Math.min(Math.max(distance / 12, 7), 16);

        title.style.setProperty(
          "--music-title-scroll-distance",
          `${distance}px`
        );
        title.style.setProperty(
          "--music-title-scroll-duration",
          `${duration}s`
        );
        title.classList.add("is-overflowing");
      });
    }

    function setTitle(value: string) {
      setText(titleText, value);
      refreshTitleScroll();
    }

    function setControlsDisabled(disabled: boolean) {
      if (toggle) toggle.disabled = disabled;
      if (prev) prev.disabled = disabled;
      if (next) next.disabled = disabled;
    }

    function getCurrentTrack() {
      return state.tracks[state.index];
    }

    function formatTime(seconds: number) {
      if (!Number.isFinite(seconds) || seconds <= 0) return "0:00";

      const totalSeconds = Math.floor(seconds);
      const minutes = Math.floor(totalSeconds / 60);
      const remainingSeconds = totalSeconds % 60;

      return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
    }

    function renderTime() {
      if (!audio) {
        setText(time, "0:00 / 0:00");
        return;
      }

      const duration = Number.isFinite(audio.duration) ? audio.duration : 0;
      setText(
        time,
        `${formatTime(audio.currentTime)} / ${formatTime(duration)}`
      );
    }

    function render() {
      const track = getCurrentTrack();
      const hasTracks = state.tracks.length > 0;

      setControlsDisabled(!hasTracks || state.isLoading);
      root.dataset.state = state.isPlaying ? "playing" : "idle";

      if (track) {
        setTitle(track.title);
        setText(status, state.message || track.artist);
      } else if (state.isLoading) {
        setTitle("加载歌单中");
        setText(status, "点击播放后开始");
      }

      renderTime();

      toggle?.setAttribute("aria-label", state.isPlaying ? "暂停" : "播放");
      playIcon?.classList.toggle("hidden", state.isPlaying);
      pauseIcon?.classList.toggle("hidden", !state.isPlaying);
    }

    function renderProgress() {
      if (!audio || !progress) return;

      const duration = Number.isFinite(audio.duration) ? audio.duration : 0;
      const ratio = duration > 0 ? audio.currentTime / duration : 0;
      progress.style.width = `${Math.min(Math.max(ratio, 0), 1) * 100}%`;
      renderTime();
    }

    function toTrack(item: RawTrack, index: number): Track | null {
      if (!item || !item.baseUrl || !item.url || !item.ext) return null;

      return {
        title: item.title?.trim() || `Track ${index + 1}`,
        artist: item.artist?.trim() ?? "",
        src: `${item.baseUrl}${item.url}${item.ext}`,
      };
    }

    function loadTrack(index: number) {
      const track = state.tracks[index];
      if (!audio || !track) return;

      state.index = index;
      state.message = "";
      audio.src = track.src;
      audio.load();
      renderProgress();
      render();
    }

    async function playCurrent() {
      if (!audio) return;

      try {
        await audio.play();
        state.isPlaying = true;
        render();
      } catch {
        state.isPlaying = false;
        state.message = "播放失败，请稍后重试";
        render();
      }
    }

    function pauseCurrent() {
      if (!audio) return;

      audio.pause();
      state.isPlaying = false;
      render();
    }

    function shiftTrack(delta: number) {
      if (!state.tracks.length) return;

      const nextIndex =
        (state.index + delta + state.tracks.length) % state.tracks.length;
      const shouldResume = state.isPlaying;
      loadTrack(nextIndex);

      if (shouldResume) {
        void playCurrent();
      }
    }

    async function requestPlaylist() {
      try {
        return await fetch(playlistUrl, {
          referrer: "http://localhost:54321/",
          referrerPolicy: "strict-origin-when-cross-origin",
        });
      } catch (error) {
        if (!(error instanceof TypeError)) throw error;

        return fetch(playlistUrl, {
          referrerPolicy: "strict-origin-when-cross-origin",
        });
      }
    }

    async function fetchPlaylist() {
      state.isLoading = true;
      state.message = "";
      render();

      try {
        const response = await requestPlaylist();

        if (!response.ok) {
          throw new Error(`Playlist request failed: ${response.status}`);
        }

        const data: unknown = await response.json();
        const tracks = Array.isArray(data)
          ? data
              .map((item, index) => toTrack(item as RawTrack, index))
              .filter((track): track is Track => Boolean(track))
          : [];

        if (!tracks.length) {
          throw new Error("Playlist is empty");
        }

        state.tracks = tracks;
        state.index = 0;
        state.isLoading = false;
        state.message = "";
        loadTrack(0);
      } catch {
        state.isLoading = false;
        state.isPlaying = false;
        state.message = "请稍后刷新重试";
        setControlsDisabled(true);
        setTitle("歌单加载失败");
        setText(status, state.message);
      }
    }

    window.addEventListener("resize", refreshTitleScroll);

    toggle?.addEventListener("click", () => {
      if (audio?.paused) {
        void playCurrent();
      } else {
        pauseCurrent();
      }
    });

    prev?.addEventListener("click", () => shiftTrack(-1));
    next?.addEventListener("click", () => shiftTrack(1));

    audio?.addEventListener("play", () => {
      state.isPlaying = true;
      state.message = "";
      render();
    });

    audio?.addEventListener("pause", () => {
      state.isPlaying = false;
      render();
    });

    audio?.addEventListener("ended", () => shiftTrack(1));
    audio?.addEventListener("loadedmetadata", renderProgress);
    audio?.addEventListener("timeupdate", renderProgress);

    audio?.addEventListener("error", () => {
      state.isPlaying = false;
      state.message = "音频加载失败";
      render();
    });

    void fetchPlaylist();
  }
</script>
